#!/usr/bin/env bash
# loop — launch the agent-loop TUI from anywhere.
#
# Usage:  loop
#
# The agent operates on the directory you invoke `loop` from (AGENT_LOOP_WORKDIR).
# Model credentials are read from the environment, or from an optional .env at
# the repo root (e.g. AGENT_LOOP_MODEL=gpt-4o, OPENAI_API_KEY=...).
set -euo pipefail

# Resolve the repo root from this script's real location (follows symlinks).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# The directory the user launched from is the agent's workspace.
export AGENT_LOOP_WORKDIR="${AGENT_LOOP_WORKDIR:-$PWD}"

# Optional project-level config (model + API keys).
if [ -f "$ROOT/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$ROOT/.env"
  set +a
fi

cd "$ROOT/tui"

# First run: install JS deps.
if [ ! -d node_modules/ink ]; then
  echo "loop: installing TUI dependencies (first run)…" >&2
  npm install --legacy-peer-deps >/dev/null 2>&1
fi

exec npm run --silent dev
