# Copy to .env and fill in. Loaded automatically by `loop` and the Telegram bot.

# --- Model provider (pick ONE key; auto-detected, no model name needed) ---
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# Optional explicit override (skips auto-detect):
# AGENT_LOOP_MODEL=gpt-4o-mini

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Lock the bot to one chat (otherwise it prints a /confirm pairing code on start):
# AGENT_LOOP_TELEGRAM_CHAT_ID=

# --- Autonomy ---
# full-access (default) auto-approves every tool. Use workspace to sandbox to the cwd.
# AGENT_LOOP_PERMISSION_MODE=full-access
# Cycles a /mission runs before stopping (/auto ignores this and runs perpetually):
# AGENT_LOOP_MISSION_CYCLES=1
# Directory the agent operates in (defaults to where you launch from):
# AGENT_LOOP_WORKDIR=
